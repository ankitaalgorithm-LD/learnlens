# Copy this file to .env and fill it in.

# Password for the dashboard and admin API. Use a long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string

# The public address of this server, as learners' browsers will reach it.
# Wrapped SCORM packages and SDK snippets send data here. Use HTTPS in production.
PUBLIC_URL=https://learnlens.your-company.com

# Secret used to pseudonymise learner IDs. Set once and never change it.
HASH_SECRET=change-me-to-another-long-random-string

# Optional: alerts and report links are POSTed here (Slack/Teams incoming webhook, Zapier, Make...).
ALERT_WEBHOOK_URL=

# Optional (docker compose only)
POSTGRES_PASSWORD=learnlens
PORT=4000
